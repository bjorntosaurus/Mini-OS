/* generated by gui/theme.py — reference copy of the page stylesheet (cpu palette) */

QWidget { color:#f1eedd; font-family:Inter, 'Segoe UI', Arial, sans-serif; font-size:13px; }
QWidget#page, QWidget#content { background:#1c2826; }
QToolTip { background:#26362f; color:#f1eedd; border:2px solid #0d1211; }
QLabel { background:transparent; }
QLabel[kind="h1"] { font-size:32px; font-weight:800; }
QLabel[kind="h1s"] { font-size:26px; font-weight:800; }
QLabel[kind="h1m"] { font-size:28px; font-weight:800; }
QLabel[kind="hero"] { font-size:36px; font-weight:800; }
QLabel[kind="h2"] { font-size:19px; font-weight:700; }
QLabel[kind="h3"] { font-size:15px; font-weight:700; }
QLabel[kind="big"] { font-size:34px; font-weight:800; }
QLabel[kind="big2"] { font-size:24px; font-weight:800; }
QLabel[kind="huge"] { font-size:82px; font-weight:800; }
QLabel[kind="huge2"] { font-size:34px; font-weight:800; }
QLabel[kind="stat"] { font-size:23px; font-weight:800; }
QLabel[kind="body"] { font-size:13px; }
QLabel[kind="small"] { font-size:11px; color:#868b82; }
QLabel[kind="muted"] { color:#868b82; font-size:12px; }
QLabel[kind="eyebrow"] { font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:10px; color:#868b82; }
QLabel[kind="mono"] { font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:11px; }
QLabel[kind="boldmono"] { font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:11px; font-weight:700; }
QLabel[kind="arrow"] { font-size:20px; }
QLabel[kind="refs"] { font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:22px; }
QLabel[gap="1"] { margin-top:8px; }
QLabel[kind="band"] { background:#c4f06a; color:#1d2a22; font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:11px; padding:11px 14px; border-bottom:2px solid #0d1211; }
QFrame[card="shadow"], QFrame[card="plain"], QFrame[card="whitebox"], QFrame[card="darkline"], QFrame[card="side"] { background:#26362f; border:2px solid #0d1211; }
QFrame[card="shadowaccent"], QFrame[card="accent"], QFrame[card="accentbox"], QFrame[card="accentbox2"], QFrame[card="band"] { background:#c4f06a; border:2px solid #0d1211; }
QFrame[card="band"] { border-left:none; border-right:none; border-top:none; }
QFrame[card="darkbox"] { background:#19231f; border:2px solid #0d1211; }
QFrame[card="side"] { background:#1c2826; border:none; border-right:1px solid #3a4440; }
QFrame[rule="1"] { background:#0d1211; border:none; }
QFrame[card="shadowaccent"] QLabel, QFrame[card="accent"] QLabel, QFrame[card="accentbox"] QLabel, QFrame[card="accentbox2"] QLabel, QFrame[card="band"] QLabel { color:#1d2a22; }
QFrame[card="shadowaccent"] QLabel[kind="eyebrow"], QFrame[card="accentbox2"] QLabel[kind="eyebrow"] { color:#475c34; }
QFrame[card="darkbox"] QLabel { color:#f1eedd; }
QFrame[card="plain"] QLabel[kind="mono"] { font-size:10px; }
QPushButton { background:#26362f; border:2px solid #0d1211; padding:4px 12px; font-weight:600; font-size:12px; }
QPushButton:hover { background:#5d7744; }
QPushButton:pressed { background:#c4f06a; }
QPushButton[role="primary"], QPushButton[role="seg"]:checked, QPushButton[role="memory"] { background:#c4f06a; color:#1d2a22; font-weight:700; }
QPushButton[role="primary"]:hover { background:#d3f48f; }
QPushButton[role="seg"] { font-weight:600; }
QPushButton[role="memory"] { text-align:left; font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:13px; padding:6px 14px; }
QPushButton[role="dark"] { background:#19231f; color:#f1eedd; font-weight:700; }
QPushButton[role="dark"]:hover { background:#4c6036; color:#f1eedd; }
QPushButton[role="link"] { border:none; background:transparent; font-size:11px; font-weight:600; padding:2px 4px; }
QPushButton[role="link"]:hover { background:#293431; }
QPushButton[role="mini"] { font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:10px; padding:3px 9px; }
QPushButton[role="mini"]:checked { background:#c4f06a; color:#1d2a22; }
QPushButton[role="flat"] { border:none; background:transparent; font-size:16px; font-weight:700; padding:0 6px; }
QPushButton[role="flat"]:hover { background:#293431; }
QPushButton[role="nav"] { border:none; background:transparent; text-align:left; padding:6px 8px; font-size:12px; font-weight:500; }
QPushButton[role="nav"]:hover { background:#293431; }
QPushButton[role="nav"]:checked { background:#3a4440; font-weight:700; }
QPushButton[role="theme"] { background:#26362f; padding:0; }
QPushButton[role="theme"]:checked { background:#26362f; border:3px solid #0d1211; }
QPushButton[role="swatch"] { padding:0; }
QPushButton[role="swatch"]:checked { border:3px solid #0d1211; }
QPushButton[role="toggle"] { font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:10px; font-weight:700; padding:0; background:#293431; }
QPushButton[role="toggle"]:checked { background:#c4f06a; color:#1d2a22; }
QLineEdit, QSpinBox, QComboBox { background:#26362f; border:2px solid #0d1211; padding:2px 8px; selection-background-color:#c4f06a; selection-color:#1d2a22; font-size:13px; }
QLineEdit[kind="refs"] { border:none; background:transparent; font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:21px; padding:0; }
QLineEdit[kind="cell"] { border:none; border-bottom:1px solid #3a4440; background:transparent; font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:12px; padding:1px 0; }
QLineEdit[kind="cell"]:focus { border-bottom:2px solid #0d1211; }
QLineEdit[kind="pid"] { border:none; background:transparent; font-weight:800; font-size:17px; padding:0; }
QComboBox QAbstractItemView { background:#26362f; border:2px solid #0d1211; selection-background-color:#c4f06a; selection-color:#1d2a22; }
QComboBox::drop-down { border:none; width:22px; }
QSpinBox::up-button, QSpinBox::down-button { width:0; }
QCheckBox { spacing:8px; font-size:12px; }
QCheckBox::indicator { width:14px; height:14px; border:2px solid #0d1211; background:#26362f; }
QCheckBox::indicator:checked { background:#c4f06a; }
QScrollArea { background:transparent; border:none; }
QScrollArea > QWidget > QWidget { background:transparent; }
QScrollBar:vertical { background:transparent; width:10px; margin:0; }
QScrollBar:horizontal { background:transparent; height:10px; margin:0; }
QScrollBar::handle { background:#676d66; min-height:24px; min-width:24px; border-radius:0; }
QScrollBar::add-line, QScrollBar::sub-line { width:0; height:0; }
QScrollBar::add-page, QScrollBar::sub-page { background:transparent; }
QTableWidget { background:transparent; border:none; gridline-color:transparent; font-size:12px; outline:0; }
QTableWidget::item { padding:4px 2px; border-bottom:1px solid #3a4440; }
QTableWidget::item:selected { background:#c4f06a; color:#1d2a22; }
QHeaderView { background:transparent; }
QHeaderView::section { background:transparent; border:none; color:#868b82; font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:10px; padding:4px 2px; text-align:left; }
QTableCornerButton::section { background:transparent; border:none; }
QSlider::groove:horizontal { height:8px; background:#0d1211; }
QSlider::handle:horizontal { width:14px; height:24px; margin:-9px 0; background:#26362f; border:2px solid #0d1211; }
QSlider::sub-page:horizontal { background:#0d1211; }
QMenu { background:#26362f; border:2px solid #0d1211; padding:4px; font-size:12px; }
QMenu::item { padding:5px 22px; }
QMenu::item:selected { background:#c4f06a; color:#1d2a22; }
QMenu::separator { height:1px; background:#3a4440; margin:4px 2px; }
QDialog { background:#1c2826; }
QToolTip { padding:3px; }
