/* generated by gui/theme.py — desktop shell */

QWidget { font-family:Inter, 'Segoe UI', Arial, sans-serif; font-size:12px; color:#1d2a22; }
QWidget#MainWindow { background:#286d72; }
QWidget#desktop { background:#286d72; }
QFrame#topbar { background:#245d62; }
QFrame#topbar QLabel, QFrame#topbar QPushButton { color:#dfe8dc; font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:11px; background:transparent; border:none; padding:0; }
QFrame#topbar QPushButton:hover { color:#ffffff; }
QFrame#taskbar { background:#d1d8c3; border-top:2px solid #1d2a22; }
QFrame#taskbar QLabel { font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:11px; color:#1d2a22; }
QPushButton[role="start"] { background:#d9e0c8; border:2px solid #1d2a22; font-weight:800; font-size:13px; padding:4px 14px; text-align:left; min-width:78px; color:#1d2a22; }
QPushButton[role="task"] { background:#f4f4e9; border:2px solid #1d2a22; font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:12px; text-align:left; padding:4px 14px; min-width:230px; font-weight:400; }
QFrame#windowFrame { background:#d1d8c3; border:2px solid #1d2a22; }
QFrame#titlebar { background:#cfd8bf; border-bottom:2px solid #1d2a22; }
QFrame#titlebar QLabel { font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:12px; background:transparent; }
QPushButton[role="win"] { background:#f4f4e9; border:2px solid #1d2a22; font-size:15px; font-weight:700; min-width:26px; max-width:26px; min-height:22px; max-height:22px; padding:0; }
QPushButton[role="win"]:hover { background:#c4f06a; color:#1d2a22; }
QFrame#menubar { background:#e6e8db; }
QFrame#menubar QPushButton { border:none; background:transparent; padding:2px 0; font-size:12px; font-weight:400; }
QFrame#menubar QPushButton:hover { text-decoration:underline; }
QLabel[kind="path"] { font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:10px; color:#6f7d70; }
QFrame#statusbar { background:#e6e8db; border-top:1px solid #6f7d70; }
QLabel[kind="status"] { font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:10px; color:#6f7d70; }
QMenu { background:#f4f4e9; border:2px solid #1d2a22; padding:4px; font-size:12px; color:#1d2a22; }
QMenu::item { padding:5px 24px; }
QMenu::item:selected { background:#c4f06a; color:#1d2a22; }
QMenu::separator { height:1px; background:#6f7d70; margin:4px 2px; }
