/* generated by gui/theme.py — desktop shell */

QWidget { font-family:Inter, 'Segoe UI', Arial, sans-serif; font-size:12px; color:#e9f0e2; }
QWidget#MainWindow { background:#0f282d; }
QWidget#desktop { background:#0f282d; }
QFrame#topbar { background:#132d31; }
QFrame#topbar QLabel, QFrame#topbar QPushButton { color:#cfdcd5; font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:11px; background:transparent; border:none; padding:0; }
QFrame#topbar QPushButton:hover { color:#ffffff; }
QFrame#taskbar { background:#23363b; border-top:2px solid #0a1517; }
QFrame#taskbar QLabel { font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:11px; color:#e9f0e2; }
QPushButton[role="start"] { background:#c4f06a; border:2px solid #0a1517; font-weight:800; font-size:13px; padding:4px 14px; text-align:left; min-width:78px; color:#1d2a22; }
QPushButton[role="task"] { background:#132d31; border:2px solid #0a1517; font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:12px; text-align:left; padding:4px 14px; min-width:230px; font-weight:400; }
QFrame#windowFrame { background:#23363b; border:2px solid #0a1517; }
QFrame#titlebar { background:#2f464b; border-bottom:2px solid #0a1517; }
QFrame#titlebar QLabel { font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:12px; background:transparent; }
QPushButton[role="win"] { background:#132d31; border:2px solid #0a1517; font-size:15px; font-weight:700; min-width:26px; max-width:26px; min-height:22px; max-height:22px; padding:0; }
QPushButton[role="win"]:hover { background:#c4f06a; color:#1d2a22; }
QFrame#menubar { background:#1a262a; }
QFrame#menubar QPushButton { border:none; background:transparent; padding:2px 0; font-size:12px; font-weight:400; }
QFrame#menubar QPushButton:hover { text-decoration:underline; }
QLabel[kind="path"] { font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:10px; color:#8fa29a; }
QFrame#statusbar { background:#1a262a; border-top:1px solid #8fa29a; }
QLabel[kind="status"] { font-family:'JetBrains Mono', Consolas, 'Courier New', monospace; font-size:10px; color:#8fa29a; }
QMenu { background:#212d31; border:2px solid #0a1517; padding:4px; font-size:12px; color:#e9f0e2; }
QMenu::item { padding:5px 24px; }
QMenu::item:selected { background:#c4f06a; color:#1d2a22; }
QMenu::separator { height:1px; background:#8fa29a; margin:4px 2px; }
